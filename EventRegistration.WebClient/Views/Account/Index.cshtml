@model EventRegistration.WebClient.Models.UpdateProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<div class="page-header">
    <h1><i class="bi bi-person-circle me-2 text-primary"></i>Hồ sơ cá nhân</h1>
    <p class="subtitle">Quản lý thông tin tài khoản của bạn</p>
</div>

<div class="form-page">
    <div class="card-app">
        <div class="card-header"><i class="bi bi-pencil-square me-2"></i>Thông tin cá nhân</div>
        <div class="card-body">
            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="StudentCode" class="form-label"></label>
                    <input asp-for="StudentCode" class="form-control" />
                </div>
                <div class="mb-4">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                    </button>
                    <a asp-action="ChangePassword" class="btn btn-outline-secondary">
                        <i class="bi bi-key me-1"></i>Đổi mật khẩu
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
