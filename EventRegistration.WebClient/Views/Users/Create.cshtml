@model EventRegistration.WebClient.Models.CreateUserViewModel
@{ ViewData["Title"] = "Create User"; }

<div class="page-header">
    <h1><i class="bi bi-person-plus me-2 text-primary"></i>Tạo User mới</h1>
</div>

<div class="form-page">
    <div class="card-app">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StudentCode" class="form-label"></label>
                        <input asp-for="StudentCode" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" class="form-select">
                        <option>Student</option>
                        <option>Staff</option>
                        <option>Admin</option>
                    </select>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Tạo</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
