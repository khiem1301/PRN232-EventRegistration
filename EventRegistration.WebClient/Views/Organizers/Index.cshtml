@model List<EventRegistration.WebClient.Models.OrganizerViewModel>
@{ ViewData["Title"] = "Organizers"; var canManage = Context.Session.GetString("UserRole") is "Staff" or "Admin"; }

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1><i class="bi bi-building me-2 text-primary"></i>Organizers</h1>
        <p class="subtitle">@Model.Count ban tổ chức</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Thêm Organizer
        </a>
    }
</div>

<div class="card-app">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-building d-block"></i>
            <p>Chưa có organizer nào.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>Trạng thái</th>
                        @if (canManage) { <th class="text-end">Thao tác</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.Name</td>
                            <td class="text-muted">@item.ContactEmail</td>
                            <td>@item.ContactPhone</td>
                            <td>
                                @if (item.IsActive)
                                { <span class="badge badge-status-active">Active</span> }
                                else
                                { <span class="badge badge-status-inactive">Inactive</span> }
                            </td>
                            @if (canManage)
                            {
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-action">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-action" onclick="return confirm('Xóa organizer này?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
