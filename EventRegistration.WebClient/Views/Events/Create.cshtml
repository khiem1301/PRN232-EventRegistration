@model EventRegistration.WebClient.Models.CreateEventViewModel
@{ ViewData["Title"] = "Create Event"; }

<div class="page-header">
    <h1><i class="bi bi-plus-circle me-2 text-primary"></i>Tạo Event</h1>
</div>

<div class="form-page">
    <div class="card-app">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="StartTime" class="form-label">Bắt đầu</label>
                        <input asp-for="StartTime" type="datetime-local" class="form-control"
                               value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndTime" class="form-label">Kết thúc</label>
                        <input asp-for="EndTime" type="datetime-local" class="form-control"
                               value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RegistrationDeadline" class="form-label">Hạn đăng ký</label>
                        <input asp-for="RegistrationDeadline" type="datetime-local" class="form-control"
                               value="@Model.RegistrationDeadline.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Capacity" class="form-label">Sức chứa</label>
                        <input asp-for="Capacity" type="number" class="form-control" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LocationId" class="form-label">Location</label>
                        <select asp-for="LocationId" class="form-select">
                            @foreach (var loc in Model.Locations)
                            {
                                <option value="@loc.Id">@loc.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="OrganizerId" class="form-label">Organizer</label>
                        <select asp-for="OrganizerId" class="form-select">
                            @foreach (var org in Model.Organizers)
                            {
                                <option value="@org.Id">@org.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Tạo</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
                <p class="form-text mt-2 mb-0">
                    Event được tạo ở trạng thái <strong>Draft</strong>. Vào Manage và bấm Publish để student thấy và đăng ký được (khi còn hạn đăng ký).
                </p>
            </form>
        </div>
    </div>
</div>
