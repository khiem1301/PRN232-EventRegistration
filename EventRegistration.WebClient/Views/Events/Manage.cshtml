@model EventRegistration.WebClient.Models.EventDetailViewModel
@{ ViewData["Title"] = "Manage Event"; }

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1><i class="bi bi-gear me-2 text-primary"></i>Quản lý Event</h1>
        <p class="subtitle">@Model.Title — <span class="badge bg-light text-dark border">@Model.Status</span></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Chi tiết</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Sửa lịch</a>
    </div>
</div>

<div class="card-app mb-4">
    <div class="card-body">
        <h5 class="mb-3"><i class="bi bi-diagram-3 me-1"></i>Vòng đời sự kiện (BR-E-01)</h5>
        <p class="text-muted mb-3">
            <strong>Draft → Published</strong> do Staff/Admin bấm Publish.
            Sau đó hệ thống tự chuyển <strong>Published → Ongoing</strong> khi tới giờ bắt đầu,
            và <strong>Ongoing → Completed</strong> khi hết giờ. Hạn đăng ký chỉ quyết định student còn đăng ký được hay không.
        </p>
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0">
                <thead class="table-light">
                    <tr><th>Trạng thái</th><th>Ý nghĩa</th></tr>
                </thead>
                <tbody>
                    <tr class="@(Model.Status == "Draft" ? "table-warning" : "")">
                        <td><strong>Draft</strong></td>
                        <td>Chưa công khai — chỉ Staff/Admin thấy. Student chưa đăng ký được.</td>
                    </tr>
                    <tr class="@(Model.Status == "Published" ? "table-warning" : "")">
                        <td><strong>Published</strong></td>
                        <td>Công khai. Student đăng ký được nếu còn hạn và còn chỗ.</td>
                    </tr>
                    <tr class="@(Model.Status == "Ongoing" ? "table-warning" : "")">
                        <td><strong>Ongoing</strong></td>
                        <td>Đã tới giờ bắt đầu — tự chuyển. Không nhận đăng ký mới.</td>
                    </tr>
                    <tr class="@(Model.Status == "Completed" ? "table-warning" : "")">
                        <td><strong>Completed</strong></td>
                        <td>Đã tới giờ kết thúc — tự chuyển. Chỉ Admin sửa được.</td>
                    </tr>
                    <tr class="@(Model.Status == "Cancelled" ? "table-warning" : "")">
                        <td><strong>Cancelled</strong></td>
                        <td>Hủy thủ công từ Draft / Published / Ongoing. Không tự đổi lại.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card-app mb-4">
    <div class="card-body">
        <h5 class="mb-3">Thao tác</h5>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.Status == "Draft")
            {
                <form asp-action="Publish" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">Publish</button>
                </form>
            }
            @if (Model.Status == "Published")
            {
                <form asp-action="Start" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-primary">Start</button>
                </form>
            }
            @if (Model.Status == "Ongoing")
            {
                <form asp-action="Complete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-primary">Complete</button>
                </form>
            }
            @if (Model.Status is "Draft" or "Published" or "Ongoing")
            {
                <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this event?');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger">Cancel</button>
                </form>
            }
            @if (Model.Status is "Completed" or "Cancelled")
            {
                <p class="text-muted mb-0">Không còn thao tác chuyển trạng thái.</p>
            }
        </div>
    </div>
</div>

<div class="card-app">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <small class="text-muted">Hạn đăng ký</small>
                <div class="fw-medium">@Model.RegistrationDeadline.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Bắt đầu</small>
                <div class="fw-medium">@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Kết thúc</small>
                <div class="fw-medium">@Model.EndTime.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Đăng ký / Còn trống</small>
                <div class="fw-medium">@Model.RegisteredCount / @Model.Capacity — còn @Model.AvailableSlots</div>
            </div>
        </div>
    </div>
</div>
